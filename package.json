{
  "name": "vlw-generator-v3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "prepare": "vp config",
    "prepEngines": "uv run --project maintenance/ maintenance/synths.py engines",
    "prepSynths": "uv run --project maintenance/ maintenance/synths.py synths",
    "vdb-check": "uv run --project maintenance/ maintenance/missing-vdb.py Vocaloid,SynthesizerV,CeVIO,NewType,VoiSona"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@tailwindcss/vite": "^4.3.3",
    "daisyui": "^5.7.4",
    "handsontable": "^18.0.0",
    "sanitize-html": "^2.17.6",
    "svelte-i18n": "^4.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.2",
    "@types/sanitize-html": "^2.16.1",
    "jsdom": "^30.0.1",
    "less": "^4.8.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "svelte-multiselect": "^11.8.0",
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vite-plus": "0.2.6"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.1",
      "onFail": "download"
    }
  }
}